<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".RegisterActivity">

    <!-- 顶部黄色区域 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="42"
        android:background="@color/yellow_bg">

        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="111dp"
            android:layout_height="112dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="32dp"
            android:src="@drawable/ic_cat_logo" />

        <LinearLayout
            android:layout_width="174dp"
            android:layout_height="75dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="20dp"
            android:layout_toEndOf="@id/iv_logo"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_title"
                android:textColor="@color/text_dark"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.12"
                android:text="@string/login_subtitle"
                android:textColor="@color/text_dark"
                android:textSize="14sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 底部白色区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="58"
        android:background="@color/white"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tv_register_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/phone_register"
            android:textColor="@color/text_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 手机号输入框 -->
        <RelativeLayout
            android:id="@+id/layout_phone"
            android:layout_width="306dp"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_input">

            <TextView
                android:id="@+id/tv_code_prefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:text="+86"
                android:textColor="@color/text_dark"
                android:textSize="15sp" />

            <View
                android:id="@+id/divider"
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="14dp"
                android:layout_toEndOf="@id/tv_code_prefix"
                android:background="@color/text_light_gray" />

            <EditText
                android:id="@+id/et_phone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:layout_toEndOf="@id/divider"
                android:background="@null"
                android:hint="@string/phone_hint"
                android:inputType="phone"
                android:maxLines="1"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_light_gray"
                android:textSize="15sp" />
        </RelativeLayout>

        <!-- 密码输入框 -->

        <!-- 确认密码输入框 -->
        <RelativeLayout
            android:id="@+id/layout_password"
            android:layout_width="306dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input">

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="4dp"
                android:layout_toStartOf="@id/iv_toggle_pwd"
                android:background="@null"
                android:hint="@string/password_hint"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_light_gray"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/iv_toggle_pwd"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="14dp"
                android:contentDescription="显示密码"
                android:padding="4dp"
                android:src="@drawable/ic_eye_close" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/layout_confirm_password"
            android:layout_width="306dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input">

            <EditText
                android:id="@+id/et_confirm_password"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="4dp"
                android:layout_toStartOf="@id/iv_toggle_confirm_pwd"
                android:background="@null"
                android:hint="@string/confirm_password_hint"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_light_gray"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/iv_toggle_confirm_pwd"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="14dp"
                android:contentDescription="显示密码"
                android:padding="4dp"
                android:src="@drawable/ic_eye_close" />
        </RelativeLayout>

        <!-- 注册按钮 -->
        <TextView
            android:id="@+id/btn_register"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_yellow"
            android:gravity="center"
            android:text="@string/register_btn"
            android:textColor="@color/text_dark"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- 登录链接 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/has_account"
                android:textColor="@color/text_gray"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/login_text"
                android:textColor="@color/link_color"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 协议文字 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_gravity="center_horizontal"
            android:gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_agreement"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:buttonTint="@color/text_gray"
                android:checked="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/agreement_prefix"
                android:textColor="@color/text_light_gray"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_user_agreement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/user_agreement"
                android:textColor="@color/link_color"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/and"
                android:textColor="@color/text_light_gray"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_privacy_policy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy"
                android:textColor="@color/link_color"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
