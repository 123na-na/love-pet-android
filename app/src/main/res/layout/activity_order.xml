<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8E8"
    android:orientation="vertical">

    <!-- 顶部黄色标题栏：返回 + 搜索框 + 发票 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="59dp"
        android:background="@color/yellow_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <!-- 返回按钮 -->
        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="4dp"
            android:src="@drawable/ic_back" />

        <!-- 搜索框 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_round"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="搜索我的订单"
                android:textColor="#999999"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 发票 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingEnd="2dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_orders" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="发票"
                android:textColor="#333333"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tab 栏：全部 | 待付款 | 待收货/代使用 | 待评价 | 退款/售后 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/yellow_bg"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- 全部（选中态） -->
            <FrameLayout
                android:id="@+id/tab_all"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingEnd="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="全部"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="20dp"
                    android:layout_height="2dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="6dp"
                    android:background="#333333" />
            </FrameLayout>

            <!-- 待付款 -->
            <FrameLayout
                android:id="@+id/tab_unpaid"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingEnd="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="待付款"
                    android:textColor="#666666"
                    android:textSize="15sp" />

                <View
                    android:layout_width="20dp"
                    android:layout_height="2dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="6dp"
                    android:background="#333333"
                    android:visibility="invisible" />
            </FrameLayout>

            <!-- 待收货/代使用 -->
            <FrameLayout
                android:id="@+id/tab_pending"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingEnd="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="待收货/代使用"
                    android:textColor="#666666"
                    android:textSize="15sp" />

                <View
                    android:layout_width="20dp"
                    android:layout_height="2dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="6dp"
                    android:background="#333333"
                    android:visibility="invisible" />
            </FrameLayout>

            <!-- 待评价 -->
            <FrameLayout
                android:id="@+id/tab_review"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingEnd="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="待评价"
                    android:textColor="#666666"
                    android:textSize="15sp" />

                <View
                    android:layout_width="20dp"
                    android:layout_height="2dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="6dp"
                    android:background="#333333"
                    android:visibility="invisible" />
            </FrameLayout>

            <!-- 退款/售后 -->
            <FrameLayout
                android:id="@+id/tab_refund"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="退款/售后"
                    android:textColor="#666666"
                    android:textSize="15sp" />

                <View
                    android:layout_width="20dp"
                    android:layout_height="2dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="6dp"
                    android:background="#333333"
                    android:visibility="invisible" />
            </FrameLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE" />

    <!-- 订单列表区域 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/order_list_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 订单卡片会动态添加到这里 -->

        </LinearLayout>
    </ScrollView>

</LinearLayout>
