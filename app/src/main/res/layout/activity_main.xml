<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- 内容区域容器 -->
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ========== 首页内容 ========== -->
        <ScrollView
            android:id="@+id/content_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 顶部栏：定位 + 搜索框 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_location" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/location"
                        android:textColor="#333333"
                        android:textSize="14sp" />

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_input"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp">

                        <ImageView
                            android:id="@+id/iv_search_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_search_small" />

                        <EditText
                            android:id="@+id/et_search"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_toEndOf="@id/iv_search_icon"
                            android:layout_marginStart="10dp"
                            android:background="@null"
                            android:hint="@string/search_hint"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColorHint="#999999"
                            android:textSize="14sp" />
                    </RelativeLayout>
                </LinearLayout>

                <!-- Banner 卡片 (三层叠放，居中显示) -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center">

                    <!-- 居中容器，固定宽度335dp -->
                    <FrameLayout
                        android:layout_width="335dp"
                        android:layout_height="148dp"
                        android:layout_gravity="center_horizontal">

                        <!-- 底层：宽而矮的圆角矩形，居中 -->
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:scaleType="fitXY"
                            android:src="@drawable/bg_input_round" />

                        <!-- 中层：窄而高的黄色矩形 -->
                        <ImageView
                            android:layout_width="400dp"
                            android:layout_height="151dp"
                            android:layout_gravity="center"
                            android:src="@drawable/img_store_2" />

                        <!-- 顶层内容：文字 + 爪印 + 猫咪头像 -->
                        <RelativeLayout
                            android:layout_width="251dp"
                            android:layout_height="174dp"
                            android:layout_gravity="center"
                            android:paddingStart="24dp"
                            android:paddingEnd="14dp"
                            android:visibility="visible">

                            <!-- 左侧文字 -->
                            <LinearLayout
                                android:id="@+id/banner_text"
                                android:layout_width="105dp"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="80dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/img_welcome" />

                                <ImageView
                                    android:layout_width="72dp"
                                    android:layout_height="22dp"
                                    android:layout_marginTop="4dp"
                                    android:src="@drawable/img_pet_family" />
                            </LinearLayout>

                            <!-- 左下角爪印 -->
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_below="@id/banner_text"
                                android:layout_alignParentBottom="true"
                                android:layout_marginBottom="12dp"
                                android:src="@drawable/nav_profile_selected" />

                            <!-- 右上角：半圆形背景（边贴着中间层矩形上边缘） -->

                            <!-- 右侧狗头（垂直居中） -->

                            <ImageView
                                android:layout_width="90dp"
                                android:layout_height="92dp"
                                android:layout_alignParentTop="true"
                                android:layout_alignParentEnd="true"
                                android:layout_marginTop="14dp"
                                android:layout_marginEnd="-2dp"
                                android:scaleType="fitStart"
                                android:src="@drawable/bg_circle_yellow" />

                            <ImageView
                                android:layout_width="83dp"
                                android:layout_height="85dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/ic_dog_face" />
                        </RelativeLayout>
                </FrameLayout>
                </FrameLayout>

                <!-- 服务图标 2x2 网格 -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="28dp"
                    android:layout_marginEnd="24dp"
                    android:columnCount="2"
                    android:rowCount="2">

                    <LinearLayout
                        android:id="@+id/btn_service_shower"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingBottom="12dp">

                        <ImageView
                            android:layout_width="79dp"
                            android:layout_height="78dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/animal_hospital" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/service_shower"
                            android:textColor="#333333"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_service_grooming"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingBottom="12dp">

                        <ImageView
                            android:layout_width="73dp"
                            android:layout_height="77dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_service_grooming" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/service_grooming"
                            android:textColor="#333333"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_service_shop"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingBottom="12dp">

                        <ImageView
                            android:layout_width="76dp"
                            android:layout_height="73dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_service_shop" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/service_shop"
                            android:textColor="#333333"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_service_adopt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingBottom="12dp">

                        <ImageView
                            android:layout_width="75dp"
                            android:layout_height="74dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_service_adopt" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/service_adopt"
                            android:textColor="#333333"
                            android:textSize="15sp" />
                    </LinearLayout>
                </GridLayout>

                <!-- 附近门店 标题栏 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="26dp"
                    android:layout_marginEnd="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="@string/nearby_stores"
                        android:textColor="#333333"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- 附近门店 图片轮播 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="20dp"
                    android:orientation="vertical">

                    <ViewFlipper
                        android:id="@+id/vf_nearby_stores"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:autoStart="false"
                        android:flipInterval="3000"
                        android:inAnimation="@anim/slide_in_right"
                        android:outAnimation="@anim/slide_out_left">

                        <include layout="@layout/item_store_banner_1" />
                        <include layout="@layout/item_store_banner_2" />
                        <include layout="@layout/item_store_banner_3" />
                    </ViewFlipper>

                    <LinearLayout
                        android:id="@+id/ll_store_dots"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:orientation="horizontal" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ========== 宠图内容 ========== -->
        <include
            android:id="@+id/content_pet"
            layout="@layout/activity_pet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- ========== 扫一扫内容 ========== -->
        <LinearLayout
            android:id="@+id/content_scan"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_scan"
                android:textColor="#999999"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- ========== 动态内容 ========== -->
        <include
            android:id="@+id/content_news"
            layout="@layout/activity_dynamic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- ========== 我的内容 ========== -->
        <include
            android:id="@+id/content_profile"
            layout="@layout/activity_profile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 底部导航栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 首页 (默认选中) -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_home"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/nav_home_selected" />

            <TextView
                android:id="@+id/tv_nav_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_home"
                android:textColor="#FFD93D"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 宠图 -->
        <LinearLayout
            android:id="@+id/nav_pet"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_pet"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/nav_pet_normal" />

            <TextView
                android:id="@+id/tv_nav_pet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_pet"
                android:textColor="#999999"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 发帖 -->
        <LinearLayout
            android:id="@+id/nav_scan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_scan"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/nav_post" />

            <TextView
                android:id="@+id/tv_nav_scan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:text="@string/nav_scan"
                android:textColor="#999999"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- 动态 -->
        <LinearLayout
            android:id="@+id/nav_news"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_news"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_dynamic" />

            <TextView
                android:id="@+id/tv_nav_news"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_news"
                android:textColor="#999999"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 我的 -->
        <LinearLayout
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_profile"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/nav_news_normal" />

            <TextView
                android:id="@+id/tv_nav_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_profile"
                android:textColor="#999999"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
