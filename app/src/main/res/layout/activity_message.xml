<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8E1"
    android:orientation="vertical">

    <!-- 顶部栏 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#FFD93D"
        android:elevation="1dp">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="消息"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- 三个导航栏 -->
    <LinearLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#FFD93D"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tab_shop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_tab_shop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="客服消息"
                android:textColor="#FFB74D"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/v_tab_shop"
                android:layout_width="24dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="#FFB74D" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_booking"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_tab_booking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="预约提醒"
                android:textColor="#999999"
                android:textSize="14sp" />

            <View
                android:id="@+id/v_tab_booking"
                android:layout_width="24dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="#00000000" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_petgram"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_tab_petgram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="宠图互动"
                android:textColor="#999999"
                android:textSize="14sp" />

            <View
                android:id="@+id/v_tab_petgram"
                android:layout_width="24dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="#00000000" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_system"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_tab_system"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="系统通知"
                android:textColor="#999999"
                android:textSize="14sp" />

            <View
                android:id="@+id/v_tab_system"
                android:layout_width="24dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="#00000000" />
        </LinearLayout>
    </LinearLayout>

    <!-- 宠图互动子分类（仅宠图Tab显示） -->
    <LinearLayout
        android:id="@+id/sub_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#FFD93D"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/sub_tab_like"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="赞和收藏"
            android:textColor="#FFB74D"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sub_tab_follow"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="新增关注"
            android:textColor="#999999"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/sub_tab_comment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="评论"
            android:textColor="#999999"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 消息列表 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/ll_message_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="24dp" />
        </ScrollView>

        <!-- 空状态 -->
        <LinearLayout
            android:id="@+id/layout_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_orders"
                android:alpha="0.3" />

            <TextView
                android:id="@+id/tv_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text=""
                android:textColor="#333333"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
